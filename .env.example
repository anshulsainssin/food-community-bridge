# Required for the app to start (see src/integrations/supabase/client.ts).
# These are Supabase's public anon/publishable identifiers, safe to expose to the browser.
# Copy this file to .env and fill in the values from your Supabase project settings
# (Project Settings -> API), or from Lovable Cloud if this project is connected there.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""

# Vite only exposes VITE_-prefixed variables to client code, so the same values are
# duplicated with that prefix for the browser bundle.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Server-only secrets. Never prefix these with VITE_ (that would ship them to the browser)
# and never commit real values for them.
# Used by src/integrations/supabase/client.server.ts for privileged, RLS-bypassing operations.
SUPABASE_SERVICE_ROLE_KEY=""
# Used by src/integrations/supabase/cron-auth.ts to authenticate scheduled/cron requests.
LOVABLE_CRON_SECRET=""
LOVABLE_CRON_SECRET_PREVIOUS=""
