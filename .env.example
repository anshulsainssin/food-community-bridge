# Copy this file to .env and fill in the values. .env is git-ignored — never commit real secrets.
# All of these are server-only: none are prefixed with VITE_, so none reach the browser bundle.

# --- MongoDB -------------------------------------------------------------------------------
# Connection string, e.g. from MongoDB Atlas (Database -> Connect -> Drivers).
MONGODB_URI=""
# Database name. Only needed when MONGODB_URI doesn't include one (Atlas URIs usually don't).
MONGODB_DB="food_waste_connect"

# --- Google sign-in (Google Cloud Console) --------------------------------------------------
# APIs & Services -> Credentials -> Create credentials -> OAuth client ID -> "Web application".
# Add this Authorized redirect URI (plus your production URL's equivalent):
#   http://localhost:8080/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public base URL of the app, used to build the OAuth redirect URI. Optional locally (the
# request's origin is used); set it in production if the app sits behind a proxy.
APP_URL=""

# --- Sessions & access ----------------------------------------------------------------------
# Random string (32+ chars) that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# Comma-separated Google account emails that are granted admin access when they sign in.
ADMIN_EMAILS=""
