# Copy this file to .env and fill in the values. .env is git-ignored — never commit real secrets.
# All of these are server-only: none are prefixed with VITE_, so none reach the browser bundle.

# --- MongoDB -------------------------------------------------------------------------------
# Connection string, e.g. from MongoDB Atlas (Database -> Connect -> Drivers).
MONGODB_URI=""
# Database name. Only needed when MONGODB_URI doesn't include one (Atlas URIs usually don't).
MONGODB_DB="food_waste_connect"

# --- Sessions -------------------------------------------------------------------------------
# Random string (32+ chars) that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# --- Admin access ---------------------------------------------------------------------------
# Admins aren't granted automatically (sign-up has no email verification, so anyone could
# register an admin's address first). After the admin creates an account on the site, run
# this once in mongosh / Atlas Data Explorer against the database above:
#   db.admins.insertOne({ _id: db.profiles.findOne({ login_email: "admin@example.org" })._id, created_at: new Date() })
